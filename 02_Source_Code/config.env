# ==============================================================================
# config.env — Dynamic Automated Timestamped Storage Manifest
# ==============================================================================
BASE_DIR="/c/Users/suhan/Desktop/android_pipeline"
APK_INPUT_DIR="${BASE_DIR}/apks"

# USER SELECTION SAFE GUARD - Automatically handles run isolation timestamps
CURRENT_RUN_ID="run_$(date +%Y%m%d_%H%M%S)"
RUN_ROOT="${BASE_DIR}/audit_runs/${CURRENT_RUN_ID}"

LOG_DIR="${RUN_ROOT}/logs"
RESULTS_DIR="${RUN_ROOT}/results"
DECOMPILE_DIR="${RUN_ROOT}/decompiled"

JADX_BIN="/c/Tools/jadx/bin/jadx.bat"
JADX_THREADS=2
JADX_TIMEOUT_SEC=600

SEMGREP_BIN="/c/Users/suhan/Desktop/android_pipeline/.venv/Scripts/semgrep.exe"
SEMGREP_RULES_DIR="p/owasp-top-ten"
SEMGREP_TIMEOUT_SEC=900

NATIVE_INVENTORY_SCRIPT="${BASE_DIR}/native_lib_inventory.sh"
FAILOVER_SCRIPT="${BASE_DIR}/snyk_owasp_failover.py"
MAX_PARALLEL_APKS=1

mkdir -p "$LOG_DIR" "$RESULTS_DIR" "$DECOMPILE_DIR" 2>/dev/null || true
